# CivicLedger 配置（docker-compose 已内置默认值，本地裸机运行时复制为 .env）

# 异步驱动由 SQLAlchemy 选择（postgresql+psycopg 同时支持 psycopg3 同步/异步）
DATABASE_URL=postgresql+psycopg://civicledger:civicledger@localhost:56510/civicledger

# 演示用 Bearer Token，生产部署必须替换并置于网关/身份提供者之后
MANAGER_TOKEN=dev-manager-token
ACCOUNTANT_TOKEN=dev-accountant-token
AUDITOR_TOKEN=dev-auditor-token
