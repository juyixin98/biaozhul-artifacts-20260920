{
  "name": "resource-version-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Resource versioning API with strong/weak ETags and RFC 9110 conditional requests (If-Match / If-None-Match / date validators)",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --import tsx src/server.ts",
    "dev": "node --import tsx --watch src/server.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "demo": "bash scripts/demo.sh"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
