{
  "name": "jsonrpc-batch-service",
  "version": "1.0.0",
  "private": true,
  "description": "JSON-RPC 2.0 local batch service with notifications, async side-effect operations and queryable operation ledger",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.1.4"
  }
}
