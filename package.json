{
  "name": "composite-partial-aggregator",
  "version": "1.0.0",
  "description": "Composite query API with partial-failure aggregation (TypeScript + Node.js + Fastify + SQLite)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('data','dist/data',{recursive:true})\"",
    "start": "node dist/server.js",
    "dev": "node --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=tap --test-reporter-destination=logs/test.tap.log test/*.test.ts",
    "test:cover": "node --import tsx --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-reporter=spec test/*.test.ts",
    "demo": "bash scripts/demo.sh"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
