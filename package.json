{
  "name": "resource-version-api",
  "version": "1.0.0",
  "private": true,
  "description": "Resource versioning API with strong/weak ETags and conditional request handling (If-Match / If-None-Match / date validators)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:verbose": "LOG_TESTS=1 vitest run",
    "replay": "tsx scripts/replay.ts fixtures/replay"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^5.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.0.2"
  }
}
