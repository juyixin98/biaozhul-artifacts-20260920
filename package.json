{
  "name": "nft-metadata-consistency",
  "version": "1.0.0",
  "description": "Local NFT metadata content-addressing consistency verification service (Fastify + TypeScript + SQLite)",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "make:examples": "tsx scripts/make-examples.ts"
  },
  "engines": {
    "node": ">=18.19"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "fastify": "^4.29.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^18.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
