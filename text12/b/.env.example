# Copy to .env or rely on docker-compose defaults.
DATABASE_URL=postgresql+psycopg2://cloudgate:cloudgate@db:5432/cloudgate
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720

# Bootstrapped once on first startup by the platform super-admin.
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=admin12345

# Lease lifecycle.
HEARTBEAT_INTERVAL_SECONDS=60
HEARTBEAT_TIMEOUT_SECONDS=600
SWEEP_INTERVAL_SECONDS=30
