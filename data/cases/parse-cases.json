[
  {
    "name": "decimal fraction of a second",
    "endpoint": "parse",
    "request": {"text": "1.5", "format": "DECIMAL", "unit": "SECOND", "toUnit": "MILLISECOND"},
    "expect": {"ok": true, "result": "1500", "exact": true}
  },
  {
    "name": "negative decimal fraction",
    "endpoint": "parse",
    "request": {"text": "-0.5", "format": "DECIMAL", "unit": "SECOND", "toUnit": "NANOSECOND"},
    "expect": {"ok": true, "result": "-500000000", "exact": true}
  },
  {
    "name": "fraction finer than target needs rounding",
    "endpoint": "parse",
    "request": {"text": "1.2345", "format": "DECIMAL", "unit": "SECOND", "toUnit": "MILLISECOND"},
    "expect": {"ok": false, "code": "INEXACT"}
  },
  {
    "name": "fraction finer than target with HALF_UP",
    "endpoint": "parse",
    "request": {"text": "1.2345", "format": "DECIMAL", "unit": "SECOND", "toUnit": "MILLISECOND", "rounding": "HALF_UP"},
    "expect": {"ok": true, "result": "1235", "exact": false}
  },
  {
    "name": "negative fraction finer than target with FLOOR",
    "endpoint": "parse",
    "request": {"text": "-1.2345", "format": "DECIMAL", "unit": "SECOND", "toUnit": "MILLISECOND", "rounding": "FLOOR"},
    "expect": {"ok": true, "result": "-1235", "exact": false}
  },
  {
    "name": "exponent notation is not accepted",
    "endpoint": "parse",
    "request": {"text": "1e3", "format": "DECIMAL", "unit": "SECOND", "toUnit": "MILLISECOND"},
    "expect": {"ok": false, "code": "INVALID_TEXT"}
  },
  {
    "name": "ISO-8601 epoch zero",
    "endpoint": "parse",
    "request": {"text": "1970-01-01T00:00:00Z", "format": "ISO_INSTANT", "toUnit": "SECOND"},
    "expect": {"ok": true, "result": "0", "exact": true}
  },
  {
    "name": "ISO-8601 negative epoch with fractional second",
    "endpoint": "parse",
    "request": {"text": "1969-12-31T23:59:59.5Z", "format": "ISO_INSTANT", "toUnit": "MILLISECOND"},
    "expect": {"ok": true, "result": "-500", "exact": true}
  },
  {
    "name": "ISO-8601 last nanosecond before epoch",
    "endpoint": "parse",
    "request": {"text": "1969-12-31T23:59:59.999999999Z", "format": "ISO_INSTANT", "toUnit": "NANOSECOND"},
    "expect": {"ok": true, "result": "-1", "exact": true}
  },
  {
    "name": "ISO-8601 with zone offset",
    "endpoint": "parse",
    "request": {"text": "1970-01-01T01:00:00+01:00", "format": "ISO_INSTANT", "toUnit": "SECOND"},
    "expect": {"ok": true, "result": "0", "exact": true}
  },
  {
    "name": "ISO-8601 fraction beyond nanoseconds requires rounding",
    "endpoint": "parse",
    "request": {"text": "2026-09-25T00:00:00.1234567899Z", "format": "ISO_INSTANT", "toUnit": "NANOSECOND"},
    "expect": {"ok": false, "code": "INEXACT"}
  },
  {
    "name": "ISO-8601 invalid month is rejected",
    "endpoint": "parse",
    "request": {"text": "2026-13-01T00:00:00Z", "format": "ISO_INSTANT", "toUnit": "SECOND"},
    "expect": {"ok": false, "code": "INVALID_TEXT"}
  },
  {
    "name": "ISO-8601 missing offset is rejected",
    "endpoint": "parse",
    "request": {"text": "2026-09-25T00:00:00", "format": "ISO_INSTANT", "toUnit": "SECOND"},
    "expect": {"ok": false, "code": "INVALID_TEXT"}
  }
]
