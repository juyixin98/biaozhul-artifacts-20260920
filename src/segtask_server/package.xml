<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>segtask_server</name>
  <version>1.0.0</version>
  <description>ROS2 action server executing segmented synthetic tasks with SQLite-backed persistence, idempotent goal IDs, atomic cancel/complete arbitration and restart recovery.</description>
  <maintainer email="dev@example.com">segtask</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>segtask_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
