        ],
        "B": [
          { "lower": "2024-02-01T00:00:00Z", "lowerOpen": false, "upper": "2024-02-15T00:00:00Z", "upperOpen": false },
          { "lower": "2024-03-15T12:00:00Z", "lowerOpen": false, "upper": "2024-03-20T00:00:00Z", "upperOpen": true }
        ]
      }
    },
    {
      "id": "time-dst-europe-2024",
