{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=videoforge;Username=videoforge;Password=videoforge"
  },
  "VideoForge": {
    "DataDirectory": "/var/lib/videoforge",
    "MaxMaterialBytes": 52428800,
    "MaxParallelJobs": 3,
    "PollIntervalMs": 300,
    "StaleJobSeconds": 45,
    "MaxAttempts": 3,
    "OutputWidth": 1280,
    "OutputHeight": 720,
    "FFmpegPath": "ffmpeg",
    "FFprobePath": "ffprobe",
    "WorkerEnabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
