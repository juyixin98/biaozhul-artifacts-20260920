  "actions": [
    {
      "id": "carry_a",
      "duration": 3,
      "start_condition": [],
      "invariant": [],
      "effects": [{"fluent": "x", "op": "+", "amount": 1}],
      "resource_use": [{"resource": "robot", "amount": 1}]
    },
    {
      "id": "carry_b",
      "duration": 2,
      "start_condition": [{"fluent": {"id": "x", "op": ">=", "value": 1}}],
      "invariant": [{"fluent": {"id": "x", "op": ">=", "value": 1}}],
      "effects": [{"fluent": "y", "op": "+", "amount": 1}],
      "resource_use": [{"resource": "robot", "amount": 1}]
    }
  ],
  "goal": {"fluent": {"id": "y", "op": ">=", "value": 1}},
  "expected": {"optimal_cost": 2, "goal_time": 5,
               "schedule": [["carry_a", 0, 3], ["carry_b", 3, 5]]}
