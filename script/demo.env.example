# 哈希时间锁回放脚本示例输入
# 用法：cp script/demo.env.example script/demo.env，按需修改后运行 bash script/demo.sh
# （不提供此文件时，脚本使用下列默认值；除 SECRET_HEX 外均可直接用默认值）

# 两条本地链的 RPC 与链 ID（对应两条相互独立的 anvil 进程）
RPC_A=http://127.0.0.1:8545
RPC_B=http://127.0.0.1:8546
CHAIN_A_ID=31337
CHAIN_B_ID=31338

# anvil 预置测试账户（公开私钥，仅限本地！）
ALICE_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BOB_PK=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# 兑换金额（最小单位，1e18 = 1 个代币）
AMOUNT_A=100000000000000000000   # Alice 卖出 100 TKA
AMOUNT_B=50000000000000000000    # 换得  50 TKB

# 场景一时间参数（相对脚本启动时的链时间，秒）
SECONDS_TO_TB=120                # B 链（被领取方）120s 后到期
SAFETY_MARGIN=300                # 安全间隔：A 链截止 = B 链截止 + 300s

# 场景二（退款）时间参数
SECONDS_TO_TB2=40
SAFETY_MARGIN2=120

# 原像（32 字节十六进制）。留空则脚本每次用 openssl rand -hex 32 现场生成。
# 固定示例（对应 test 中的 crosschain_secret_007 之外的独立随机值亦可）：
SECRET_HEX=
