{
  "registry": {
    "packages": {
      "app": [
        { "name": "app", "version": "1.0.0", "dependencies": [
          { "name": "core",     "req": "^1.0", "optional": false },
          { "name": "cache",    "req": "^1.0", "optional": true, "feature": "fast" },
          { "name": "io_uring", "req": "^1.0", "optional": false,
            "target": { "os": "linux" } }
        ]}
      ],
      "core":     [ { "name": "core",     "version": "1.2.0", "dependencies": [] } ],
      "cache":    [ { "name": "cache",    "version": "1.0.0", "dependencies": [] } ],
      "io_uring": [ { "name": "io_uring", "version": "1.0.0", "dependencies": [] } ]
    }
  },
  "requirements": [
    { "name": "app", "req": "*" }
  ],
  "features": { "app": ["fast"] },
  "platform": { "os": "linux", "arch": "x86_64", "family": "unix" },
  "preferences": { "cache": { "strategy": "lowest" } },
  "verify": true
