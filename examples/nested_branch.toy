// 嵌套分支制造关键边 + 短路逻辑
func main(a, b) {
    var x = 0;
    if (a > 0) {
        if (b > 0) {
            x = 1;
        } else {
            x = 2;
        }
    } else {
        x = 3;
    }
    // 汇流处使用 x；内层 merge -> 外层 merge 是一条关键边
    var y = 0;
    if (a > 5 && b > 5) {
        y = 100;
    }
    return x + y;
}
