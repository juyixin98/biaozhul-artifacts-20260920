      {"camera": "c1", "status": "matched", "imu": "i1", "dt_ms": 0.0},
      {"camera": "c2", "status": "matched", "imu": "i2a", "dt_ms": 0.0},
      {"camera": "c_late", "status": "matched", "imu": "i_late", "dt_ms": 1.0},
      {"camera": "c3", "status": "matched", "imu": "i3", "dt_ms": 2.0, "tie_break": "earlier"},
      {"camera": "c4", "status": "expired_unpaired", "imu": null},
      {"camera": "c_end", "status": "matched", "imu": "i_end", "dt_ms": 1.0}
    ],
    "imus": [
      {"imu": "i0", "status": "used_expired", "use_count": 1},
      {"imu": "i1", "status": "used_expired", "use_count": 1},
      {"imu": "i2a", "status": "used_expired", "use_count": 1},
      {"imu": "i2b", "status": "unused_expired", "use_count": 0},
      {"imu": "i_late", "status": "used_expired", "use_count": 1},
      {"imu": "i3", "status": "used_expired", "use_count": 1},
      {"imu": "i4", "status": "unused_expired", "use_count": 0},
      {"imu": "i5", "status": "unused_expired", "use_count": 0},
      {"imu": "i_end", "status": "stream_end", "use_count": 1}
    ]
  }
}
