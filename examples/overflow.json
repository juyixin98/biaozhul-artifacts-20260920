{
  "name": "bounded IMU buffer: oldest evicted with explicit overflow outcomes",
  "params": {"tolerance_ns": 5000000, "reorder_tolerance_ns": 100000000,
             "max_imu_pending": 3},
  "events": [
    {"kind": "imu", "id": "i0", "t": 0.000},
    {"kind": "imu", "id": "i1", "t": 0.001},
    {"kind": "camera", "id": "c0", "t": 0.002},
    {"kind": "imu", "id": "i2", "t": 0.002},
    {"kind": "imu", "id": "i3", "t": 0.003},
    {"kind": "imu", "id": "i_tick", "t": 0.200}
  ],
  "expect": {
    "epochs": 1,
    "pairs": [
      {"camera": "c0", "status": "matched", "imu": "i2", "dt_ms": 0.0}
    ],
    "imus": [
      {"imu": "i0", "status": "imu_buffer_overflow"},
      {"imu": "i1", "status": "imu_buffer_overflow"},
      {"imu": "i2", "status": "used_expired", "use_count": 1},
      {"imu": "i3", "status": "unused_expired", "use_count": 0},
      {"imu": "i_tick", "status": "stream_end", "use_count": 0}
    ]
  }
}
