// 07_loop.tfl —— while 循环：污点在循环中累积/清洗
fn main() {
    x = source();
    i = 0;
    while (i < 3) {
        x = x + 1;      // 运算保持污点（循环 0..n 次都覆盖）
        i = i + 1;
    }
    sink(x);            // 应当告警：x 初始即污点，循环不去污

    y = source();
    j = 0;
    while (j < 3) {
        y = clean(y);   // 每次都清洗
        j = j + 1;
    }
    sink(y);            // 不应告警：循环体内无条件清洗
}
