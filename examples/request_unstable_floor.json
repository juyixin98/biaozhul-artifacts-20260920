{
  "filter": {"type": "sos",
             "sections": [[0.25, 0.0, -0.25, 1.0, -1.9, 0.91]]},
  "fixed": {
    "sig": [1, 5],
    "coef": [2, 2],
    "guard_bits": 1,
    "rounding": "floor",
    "overflow": "saturate"
  },
  "input": {"kind": "impulse", "n": 128, "amplitude": 1.0},
  "output": {"dir": "out/unstable", "basename": "unstable",
             "pcm": true, "csv": true, "npy": true},
  "analyze": true
}
