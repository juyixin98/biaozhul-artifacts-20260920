{
  "name": "acceptance-restart-recovery",
  "description": "验收：持久化只存墙钟截止瞬间；重启后 nanoTime 纪元重置，必须重新计算单调死线",
  "initialWallClock": "2026-09-25T09:00:00Z",
  "initialMonotonicNanos": 1000000000,
  "steps": [
    {"op": "schedule", "timeoutId": "acc-r", "ruleId": "grace-two-minutes", "version": "1",
     "note": "安排 2 分钟超时，墙钟截止 09:02Z"},
    {"op": "advance", "durationIso": "PT90S", "note": "崩溃前单调流逝 90 秒（墙钟停在场景设定值）"},

    {"op": "restart", "newMonotonicNanos": 8000000000, "newWallClockInstant": "2026-09-25T09:01:30Z",
     "note": "JVM 重启：nanoTime 从新读数 8000000000 起算；墙钟恢复时为 09:01:30Z"},
    {"op": "status", "timeoutId": "acc-r",
     "note": "期望 recoveredAfterRestart=true，截止仍 09:02Z，剩余 30s，单调死线=新紀元+30s"},

    {"op": "adjustWallClock", "backwardIso": "PT1H", "note": "恢复后墙钟再被向后拨"},
    {"op": "status", "timeoutId": "acc-r", "note": "剩余仍 30s"},

    {"op": "advance", "durationIso": "PT30S", "note": "单调流逝 30 秒"},
    {"op": "status", "timeoutId": "acc-r", "note": "期望 expired=true"}
  ]
}
