// 示例 4：除零 / 模零 —— 错误行为必须在优化前后保持
//
// 红线：SCCP 即使在编译期看到除数是常量 0，也绝不能把它折叠掉
// （折叠会消灭运行期错误）。规则是：这种指令的格降为 ⊥，指令保留，
// 由运行期 IR 解释器抛出 division-by-zero。
// 同时，异常发生前已经产生的输出也必须逐行一致。

print 1;                    // 先有输出
a = 10;
b = a - a;                  // SCCP: b = const(0)
print 2;
c = 3 / b;                  // 常量除数 0 -> 不折叠；运行期在此报错
print c;                    // 不会执行
print 4;                    // 不会执行

// 可观察行为（优化前后一致）：
// 输出 1、2，随后
// runtime error: division-by-zero（位置指向 c = 3 / b 这一行）
