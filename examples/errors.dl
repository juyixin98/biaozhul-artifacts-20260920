// dlang 错误恢复示例：本文件故意包含多处错误，
// 用来演示解析器如何继续解析并报告精确位置（半开区间）。

var ok = 1;
var = 2;                    // var 后缺变量名 -> Junk 恢复
var bad = 1 +;              // 运算符缺右值
var unclosed = (1 + 2;      // 缺少右括号 -> 错误锚在 ';'
var str = "未闭合的字符串;    // 字符串缺结束引号 -> 词法错误
var arr = [1, 2 3];         // 数组元素间缺逗号
fn (a, b) { return a; }     // 函数缺名字
x = @;                      // 非法字符
var tail = 10               // 缺分号（错误锚在下一行开头）
var done = tail + 1;
