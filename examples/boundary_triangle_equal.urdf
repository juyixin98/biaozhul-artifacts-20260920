<?xml version="1.0" encoding="UTF-8"?>
<!--
  边界矩阵 1（合法边界）：主转动惯量恰好满足三角不等式等号 I3 = I1 + I2。
  取 diag(3, 2, 1)：1 + 2 = 3，等号成立 -> 必须判通过（浮点容差内）。
  质量 1 kg，等效回转半径 sqrt((3+2+1)/(3*1)) = sqrt(2) ≈ 1.414 m，量级正常。
-->
<robot name="boundary_triangle_equal">
  <link name="slender_body">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="3" ixy="0" ixz="0"
               iyy="2" iyz="0"
               izz="1"/>
    </inertial>
  </link>
</robot>
