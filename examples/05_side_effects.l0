// 示例 5：副作用指令 print 不得被错误消除
//
// print 是有副作用的指令。即使其参数在编译期已知（可以具体化），
// 指令本身必须保留；而位于不可达分支中的 print 随整个块删除是合法的
// （运行期本来就不会执行到）。关键区分：可达 print 一定保留，
// 哪怕其结果“没人用”（print 不产生值）。

// 可达 print：参数被具体化（print 7），但输出必须发生
x = 3;
x = x + 4;                  // const(7)
print x;                    // 输出 7

// 副作用在不可达块里：合法删除（运行期不可观察）
if (0) {
  print 12345;              // 不可达：无输出
  q = 1 / 0;                // 不可达：无错误
}

// 可达的动态 print：参数 ⊥，运行期求值
k = 0;
i = 1;
while (i <= 2) { k = k + 1; i = i + 1; }
if (k == 2) {
  print 100;                // 运行期条件为真 -> 输出 100
} else {
  print 200;
}

// 除零前的 print 必须保留（错误行为与错误前输出都一致）
print 9;
z = 5 / 0;                 // 运行期 division-by-zero
print 10;                  // 不可达（错误后）

// 可观察行为：
// 7
// 100
// 9
// runtime error: division-by-zero
