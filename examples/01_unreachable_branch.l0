// 示例 1：分支不可达 + 不可达块中的除零
// 条件为编译期常量 1，else 分支不可达；
// SCCP 只在可执行边上传播，因此 else 中的 7/0 不会被折叠、
// 也不会在运行期触发——它随不可达块一起删除。

x = 40;
x = x + 2;        // SCCP: x = const(42)

if (1) {
  print x;        // 直接具体化 -> print 42
} else {
  print 999;      // 不可达：不输出
  z = 7 / 0;      // 不可达块内的除零：运行期不得报错
  print z;
}

print 10;         // 可达：输出 10

// 期望输出：
// 42
// 10
