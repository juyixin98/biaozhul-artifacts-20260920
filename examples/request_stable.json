{
  "filter": {"type": "butter_lowpass", "order": 4, "cutoff": 0.2},
  "fixed": {
    "sig": [1, 15],
    "coef": [2, 14],
    "guard_bits": 2,
    "rounding": "convergent",
    "overflow": "saturate"
  },
  "input": {"kind": "multi_tone", "n": 2048,
            "components": [[0.05, 0.6], [0.35, 0.3]]},
  "output": {"dir": "out/stable", "basename": "stable",
             "pcm": true, "csv": true, "npy": true},
  "analyze": true
}
