// 示例 3：合流反例（meet）与“相关性”演示
//
// 格合流规则：top ∧ const(n) = const(n)；
//             const(a) ∧ const(b) = const(a)   若 a==b，否则 ⊥；
//             任何东西 ∧ ⊥ = ⊥。
//
// L0 没有外部输入，⊥ 的唯一来源是*动态条件下*两路合流不同常量。
// 要得到动态条件，先构造一个 ⊥，再用它做条件。

// 第一步：制造 ⊥。利用 while 回边（见示例 2）让 k 变 ⊥。
k = 0;
i = 1;
while (i <= 2) {
  k = k + 1;
  i = i + 1;
}
// 现在 k 在格上是 ⊥（运行期值为 2）。

// 反例 1：动态分支两路给不同常量 -> y = const(20) ∧ const(40) = ⊥
if (k) {
  y = 20;
} else {
  y = 40;
}
print y;                    // ⊥，运行期输出 20（k=2 为真）

// 反例 2（Wegman 经典“分支相关性”）：两路给*相同*常量 -> 合流仍是 const(7)
if (k) {
  z = 7;
} else {
  z = 7;
}
print z;                    // const(7)：即使条件未知，合流一致就是常量

// 反例 3：w 取 1 或 2（不同），下游算术全部 ⊥
if (k > 100) {
  w = 1;
} else {
  w = 2;
}
print w * 10;              // ⊥，运行期 20
print w + w;               // ⊥，运行期 4（不可因“两个操作数同名”而误折叠）

// 反例 4：⊤ 参与合流：不可达边上的值不参与 meet。
// 常量假分支永不执行，v 只取活边上的 const(5)。
v = 5;
if (0) {
  v = 500;
}
print v;                    // const(5)

// 期望输出：
// 20
// 7
// 20
// 4
// 5
