{
  "name": "overflow_large_input",
  "comment": "大幅输入溢出样例：输入幅度 1.5 超出 Q1.15 数据格式范围，触发输入饱和与状态溢出统计",
  "signal": {"type": "sine", "n": 512, "freq_hz": 500, "sample_rate": 8000, "amplitude": 1.5},
  "sos": [
