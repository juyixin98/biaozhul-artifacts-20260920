{
  "table": "sales",
  "filter": { "op": "AND", "predicates": [
    { "column": "price", "op": "=", "value": 15 },
    { "column": "qty", "op": "IS NULL" }
  ]},
  "aggregates": [
    { "fn": "COUNT_ROWS" },
    { "fn": "COUNT", "column": "qty", "alias": "cnt_qty" },
    { "fn": "SUM", "column": "qty", "alias": "sum_qty" },
    { "fn": "AVG", "column": "qty", "alias": "avg_qty" }
  ]
}
