{
  "table": {
    "name": "orders",
    "columns": [
      { "name": "id", "type": "int", "values": [10, 20, 30, null, 50, 60] },
      { "name": "amt", "type": "int", "values": [100, null, 300, 400, null, 600] },
      { "name": "status", "type": "string", "values": ["NEW", "PAID", "NEW", null, "PAID", "NEW"] }
    ]
  },
  "batchSize": 3,
  "groupBy": ["status"],
  "aggregates": [
    "count(*)",
    { "func": "count", "column": "amt" },
    { "func": "sum", "column": "amt" },
    { "func": "avg", "column": "amt" },
    { "func": "min", "column": "amt" },
    { "func": "max", "column": "amt" }
  ]
}
