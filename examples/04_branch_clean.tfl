// 04_branch_clean.tfl —— 条件清洗（FP-2 的核心样例）
//
// 真实执行语义：flag 为常量 0，只有 else 分支会执行，x 必定被清洗，
// 故真实运行中不会发生污点到达 sink。
// 但本分析不做常量传播/约束求解，两个分支都被认为“可能执行”，
// 汇合（join）时 x 的污点按并集保留 —— 这是有意的过近似，预期误报 1 条。
fn main() {
    x = source();
    flag = 0;
    if (flag) {
        // 这一支没有清洗
        x = x;
    } else {
        x = clean(x);
    }
    sink(x);
}
