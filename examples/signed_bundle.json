{
  "version": 1,
  "alg": "Ed25519",
  "kid": "2026-09-dev",
  "canonical": "https://openpolicy.local/canonical/v1",
  "policies": [
    {
      "id": "p-access",
      "name": "仓库与文档访问策略",
      "rules": [
        {
          "id": "r-allow-internal-read",
          "effect": "allow",
          "condition": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "attr": "subject.department"
                  },
                  {
                    "literal": "engineering"
                  }
                ]
              },
              {
                "op": "in",
                "args": [
                  {
                    "literal": "read"
                  },
                  {
                    "attr": "subject.clearances"
                  }
                ]
              },
              {
                "op": "intersects",
                "args": [
                  {
                    "attr": "subject.groups"
                  },
                  {
                    "literal": [
                      "internal",
                      "staff"
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "r-deny-prod-secrets",
          "effect": "deny",
          "condition": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "attr": "resource.classification"
                  },
                  {
                    "literal": "secret"
                  }
                ]
              },
              {
                "op": "contains",
                "args": [
                  {
                    "attr": "resource.tags"
                  },
                  {
                    "literal": "prod"
                  }
                ]
              },
              {
                "op": "neq",
                "args": [
                  {
                    "attr": "subject.role"
                  },
                  {
                    "literal": "admin"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "r-deny-contractors",
          "effect": "deny",
          "condition": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "attr": "subject.employment_type"
                  },
                  {
                    "literal": "contractor"
                  }
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "attr": "resource.classification"
                  },
                  {
                    "literal": "confidential"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "r-allow-clearance-superset",
          "effect": "allow",
          "condition": {
            "op": "superset",
            "args": [
              {
                "attr": "subject.clearances"
              },
              {
                "literal": [
                  "read"
                ]
              }
            ]
          }
        }
      ]
    }
  ],
  "signature": "L2wKMV0+IzzG/EWds1bnGLBeMJoaHvO8zfdW0+n7+6K93oNvfLouziUi5oBYc6RxSh9uW5KlujsLY79SwM0KDw=="
