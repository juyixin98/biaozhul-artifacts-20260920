# Direct and mutual recursion via hoisted named functions.

fn factorial(n) {
  if (n <= 1) { return 1; }
  return n * factorial(n - 1);
}
print(factorial(6));    # 720

fn fib(n) {
  if (n < 2) { return n; }
  return fib(n - 1) + fib(n - 2);
}
print(fib(12));         # 144

# Mutual recursion: even/odd are visible to each other regardless of order.
fn is_even(n) {
  if (n == 0) { return true; }
  return is_odd(n - 1);
}
fn is_odd(n) {
  if (n == 0) { return false; }
  return is_even(n - 1);
}
print(is_even(10), is_odd(7), is_even(3));   # true, true, false
