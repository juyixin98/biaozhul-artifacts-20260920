    {"at_ms": 3450, "client": "A", "op": "submit", "value": "a-late-stale-fence-1", "resource": "R", "force_submit": true, "_comment": "late message from the deposed holder: fence 1 < epoch 2, rejected twice"},
    {"at_ms": 4200, "client": "A", "op": "acquire", "_comment": "A takes a fresh lease and gets a strictly higher fence 3"},
    {"at_ms": 4800, "client": "A", "op": "submit", "value": "a-write-fence-3", "resource": "R"}
  ]
