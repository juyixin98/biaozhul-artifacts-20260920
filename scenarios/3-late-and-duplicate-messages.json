  "actions": [
    {"at_ms": 0,    "client": "A", "op": "acquire"},
    {"at_ms": 400,  "client": "A", "op": "submit", "value": "a-write-fence-1", "resource": "R"},

    {"at_ms": 1800, "client": "B", "op": "acquire", "retry": true, "_comment": "busy while lease 1 is live; granted after its expiry at 2007"},
    {"at_ms": 2600, "client": "B", "op": "submit", "value": "b-write-fence-2", "resource": "R"},
