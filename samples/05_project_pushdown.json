{
  "_comment": "例5：投影在连接与过滤之间。简单列引用的投影可凭列来源穿透（谓词改写为底层列名继续下推）；引用计算列 l.a+r.b 的谓词无基表来源，只能保留在投影上方。",
  "tables": [
    {"name": "l", "columns": ["id", "a"], "rows": [[1, 10], [2, 20]]},
    {"name": "r", "columns": ["id", "b"], "rows": [[1, 100], [2, null]]}
  ],
  "plan": {
    "op": "filter",
    "predicate": "r.b IS NOT NULL",
    "child": {
      "op": "project",
      "items": ["l.id", "l.a", "r.id", "r.b"],
      "child": {
        "op": "join",
        "joinType": "left",
        "on": ["l.id = r.id"],
        "left": {"op": "scan", "table": "l"},
        "right": {"op": "scan", "table": "r"}
      }
    }
  }
}
