     "rightUnique": true, "leftNdv": 900000, "rightNdv": 1000000},
    {"left": "order_items", "right": "products", "on": "oi_product = p_id",
     "rightUnique": true, "rightNdv": 20000, "leftNdv": 19000},
    {"left": "products", "right": "categories", "on": "p_category = cat_id",
     "rightUnique": true, "rightNdv": 40, "leftNdv": 40}
  ],
  "options": {"costModel": "TOTAL_INTERMEDIATE_ROWS"}
}
