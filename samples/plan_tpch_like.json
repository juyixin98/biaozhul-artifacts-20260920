{
  "tables": [
    {"name": "orders",      "rows": 1000000},
    {"name": "customers",   "rows":   50000},
    {"name": "order_items", "rows": 3000000},
    {"name": "products",    "rows":   20000},
    {"name": "categories",  "rows":      40}
