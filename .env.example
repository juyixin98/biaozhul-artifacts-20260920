# Copy to .env (docker compose reads it automatically).
MYSQL_DATABASE=textengine
MYSQL_USER=textengine
MYSQL_PASSWORD=textengine-pass
MYSQL_ROOT_PASSWORD=root-pass
MYSQL_HOST=db
MYSQL_PORT=3306

# Comma-separated hosts. Leave unset to allow all (dev convenience).
DJANGO_ALLOWED_HOSTS=*
DJANGO_SECRET_KEY=dev-insecure-change-me
# 0 = run the API and workers against the same DB; no external model service
# is integrated regardless of this value (engine is local-only by design).
