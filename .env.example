# 本地开发环境变量样例
# 复制为 .env 后由 pydantic-settings 自动读取
WF_DATABASE_URL=postgresql+psycopg2://wfuser:wfpass@127.0.0.1:5432/wfdb
WF_SCHEDULER_ENABLED=true
WF_SCHEDULER_INTERVAL_SECONDS=1
# 仅 Docker entrypoint 使用：启动时播种演示模板
WF_SEED_DEMO=true
# 测试库（pytest 使用）
WF_TEST_DATABASE_URL=postgresql+psycopg2://wfuser:wfpass@127.0.0.1:5432/wfdb
