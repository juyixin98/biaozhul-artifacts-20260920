# Copy to .env and adjust. docker-compose already sets safe local-test values.

# SQLAlchemy/psycopg2 URL
VAULT_DATABASE_URL=postgresql+psycopg2://vault:vault@localhost:5544/vault

# Base64-encoded 32-byte AES-256-GCM master key (encrypts custodial private keys).
# Generate one:  python -c 'import base64,os;print(base64.b64encode(os.urandom(32)).decode())'
# If unset in development, a fixed (insecure!) deterministic key is used so the
# app can boot for tests. In production the app refuses to start without it.
VAULT_MASTER_KEY_B64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

VAULT_ENVIRONMENT=development
VAULT_ALLOW_REGISTRATION=true

# Per-wallet daily signing allowance in wei (UTC calendar day).
VAULT_DAILY_QUOTA_WEI=3000000000000000000
# Minimum seconds between successful signatures of one wallet.
VAULT_COOLDOWN_SECONDS=30
