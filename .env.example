# RevStream environment configuration (copy to .env if you want overrides)

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*

# MySQL (containerized; host networking binds to 127.0.0.1)
MYSQL_PORT=3325
MYSQL_DATABASE=revstream
MYSQL_USER=revstream
MYSQL_PASSWORD=revstream
MYSQL_ROOT_PASSWORD=rootpassword

# App
WEB_PORT=8000
GUNICORN_WORKERS=4
LOAD_SAMPLE_DATA=1

# Scoring scheduler
SCORING_INTERVAL_MINUTES=30
LOG_LEVEL=INFO
