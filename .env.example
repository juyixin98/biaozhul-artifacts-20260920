# Copy to .env or export in your shell. All values are optional; defaults shown.

# Server
HOST=127.0.0.1
PORT=3000

# SQLite database file for immutable objects
DB_PATH=data/objects.db

# Structured diagnostic JSONL log. Empty string disables the file
# (records are still served via GET /diagnostics and printed to stdout).
DIAGNOSTICS_LOG=data/requests.jsonl

# Set to 1 to attach a MASKED structural preview of bodies to diagnostic
# records. Raw bytes are never logged even when this is on.
LOG_BODIES=0

# Request limits
RANGE_MAX_SPECS=50
RANGE_MAX_RESPONSE_BYTES=16777216
# 1 merges adjacent intervals too; 0 merges strict overlaps only
RANGE_MERGE_GAP=1
