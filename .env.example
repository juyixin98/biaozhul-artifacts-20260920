# Copy to .env and fill in. Never commit real keys.

# 32-byte AES-GCM master key, base64-encoded. Generate with:
#   openssl rand -base64 32
VAULT_MASTER_KEY=

# Database (docker-compose sets this for the app container)
VAULT_DATABASE_URL=postgresql+psycopg2://vault:vault@localhost:5432/vault

# Per-wallet daily signing quota in wei (value + gas_limit*gas_price per tx)
VAULT_DAILY_LIMIT_WEI=10000000000000000000

# Minimum seconds between successful signatures per wallet
VAULT_COOLDOWN_SECONDS=5
