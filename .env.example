# 复制为 .env 并按需修改。所有数据仅保存在本机 Docker 卷中，不会外发。

MYSQL_ROOT_PASSWORD=rootpw_change_me
MYSQL_DATABASE=activityguard
MYSQL_USER=guard
MYSQL_PASSWORD=guardpw_change_me
# 宿主机映射端口（容器内固定 3306）；若本机 3306 被占用可改为 3307
MYSQL_PORT=3306

# API 宿主机映射端口（容器内固定 8080）；若本机 8080 被占用可改为 18092
API_PORT=8080
APP_HTTP_ADDR=:8080
JWT_SECRET=please-change-this-secret-in-production
JWT_TTL=12h

# 允许补算（乱序/延迟上报）的时间范围：[现在-BACKFILL_WINDOW, 现在+FUTURE_SKEW]
BACKFILL_WINDOW=720h
FUTURE_SKEW=5m
BATCH_MAX_EVENTS=2000

SCHEDULER_ENABLED=true
TZDATA=UTC
