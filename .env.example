# Copy to .env and adjust as needed.
DB_ENGINE=mysql
DB_NAME=mlops
DB_USER=mlops
DB_PASSWORD=mlops_password
DB_HOST=db
DB_PORT=3306

# Heartbeat considered stale after this many seconds -> node treated as offline
HEARTBEAT_TIMEOUT_SECONDS=30
# Pending job queued longer than this is cancelled as TIMEOUT (2 hours)
QUEUE_TIMEOUT_SECONDS=7200
# Simulated grace period a worker has to release a preempted job
PREEMPT_GRACE_SECONDS=30
