# Exact rational linear algebra service configuration.
# Copy to `.env` if you run uvicorn directly; the service reads these
# environment variables (no .env parsing dependency required).

# Hard cap on the number of decimal digits any single integer coefficient
# may occupy during fraction-free elimination.
RATIONAL_LINALG_DIGIT_BUDGET=4096

# High-precision decimal digits used for display-only mpmath conversion.
RATIONAL_LINALG_DECIMAL_DPS=40

# Directory for the JSONL run/replay log.
RATIONAL_LINALG_LOG_DIR=logs
