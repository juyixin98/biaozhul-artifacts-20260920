# Copy to .env or export directly. All settings use the CV_ prefix.

# SQLAlchemy/psycopg2 connection URL
CV_DATABASE_URL=postgresql+psycopg2://consentvault:consentvault@localhost:5432/consentvault

# Whether the container entrypoint seeds demo orgs/keys/scenario (true/false)
CV_SEED_DEMO=true

# Optional fixed DEMO keys (local convenience only; never reuse in production).
# Leave unset to generate random keys printed in the startup logs.
CV_DEMO_ADMIN_KEY=demo-admin-key
CV_DEMO_AUDITOR_KEY=demo-auditor-key
CV_DEMO_ORG2_ADMIN_KEY=demo-org2-admin-key
CV_DEMO_ORG2_AUDITOR_KEY=demo-org2-auditor-key
