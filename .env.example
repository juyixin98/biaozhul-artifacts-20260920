# Copy to .env or pass via docker compose / environment.
DATABASE_URL=postgresql+psycopg2://trainer:trainer@localhost:5432/nn_training
DATA_WHITELIST_DIRS=/tmp/nnlab-data
CHECKPOINT_DIR=/tmp/nnlab-checkpoints
LEADER_LEASE_SECONDS=30
WORKER_HEARTBEAT_INTERVAL=5
MAX_RUNNING_PER_USER=3
# Set to 0 to disable the in-process training worker (tests do this).
WORKER_ENABLED=1
