# Database connection (used when DATABASE_URL is not set)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stagevault
PORT=3000
# Inactivity timeout before a session is auto-ended (default 30 minutes)
SESSION_TIMEOUT_MS=1800000
# Set to "true" to disable the periodic sweeper (tests call sweepOnce directly)
SESSION_SWEEP_DISABLED=false
