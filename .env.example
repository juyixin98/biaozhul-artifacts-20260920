# Copy to .env or export directly. All settings are prefixed SSP_.
# SQLite database file for persisted planning runs.
SSP_DB_PATH=data/plans.db
# Log level and directory for per-run log files.
SSP_LOG_LEVEL=INFO
SSP_LOG_DIR=logs
# Hard cap on per-arm n in exact one-sample binomial integer search.
SSP_EXACT_ONE_SAMPLE_CAP=200000
# Hard cap on total n for exact two-sample (Fisher) search.
SSP_EXACT_TWO_SAMPLE_TOTAL_CAP=4000
# Expected-count threshold below which the normal approximation is
# declared invalid for binomial endpoints.
SSP_APPROX_MIN_EXPECTED=5
# Default Monte Carlo trial count for simulated-power evidence.
SSP_MC_DEFAULT_TRIALS=8000
