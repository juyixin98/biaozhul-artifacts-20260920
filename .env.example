# Service
PORT=3000
# When true, request header `x-now` (ISO-8601) overrides the clock for that request.
# ONLY enable in tests / local demo, never in production.
ALLOW_CLOCK_OVERRIDE=false

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=careops
DB_USER=root
DB_PASSWORD=careops

# Demo seeding (used by docker entrypoint)
ENABLE_DEMO_SEED=true
