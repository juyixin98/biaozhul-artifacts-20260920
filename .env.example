# Copy to .env and change both tokens before starting.
# Investigator: register images, run reviews, transfer custody, add notes.
INVESTIGATOR_TOKEN=change-me-investigator-token
# Analyst: query cases/evidence/chain and add notes only.
ANALYST_TOKEN=change-me-analyst-token

# MySQL credentials
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=forensiccore
MYSQL_USER=forensic
MYSQL_PASSWORD=forensic

# Host port for the API
HTTP_PORT=8080

# Optional host directory mounted read-only at /data/evidence inside the API
# container. Only files under WHITELIST_DIRS can ever be registered.
EVIDENCE_HOST_DIR=./evidence
