# 复制为 .env 后用 `set -a; source .env; set +a` 之类方式加载，或直接在 shell 中导出。
# 全部配置均为可选项，以下为默认值。

# 监听地址与端口
RANGE_HOST=127.0.0.1
RANGE_PORT=3000

# SQLite 数据库文件；:memory: 表示纯内存库（数据不落盘）
RANGE_DB_PATH=data/objects.db

# 单个请求允许的 Range 规格数量（合并前计数）
RANGE_MAX_RANGES=16

# 单次 Range 响应的总字节上限（含 multipart 封装开销）
RANGE_MAX_RESPONSE_BYTES=67108864

# 诊断记录环形缓冲容量
RANGE_DIAGNOSTICS_CAPACITY=500
