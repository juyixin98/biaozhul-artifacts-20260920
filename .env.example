# Copy to .env (docker compose reads .env automatically)
MYSQL_DATABASE=revstream
MYSQL_USER=revstream
MYSQL_PASSWORD=revstream_pw
MYSQL_ROOT_PASSWORD=root_pw
MYSQL_HOST=db
MYSQL_PORT=3306
# Django reads these:
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
