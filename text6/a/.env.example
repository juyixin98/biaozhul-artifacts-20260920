# ConsentVault configuration (copy to .env if running outside Docker)
CONSENTVAULT_DATABASE_URL=postgresql+psycopg2://consent:consent@localhost:55435/consentvault
CONSENTVAULT_MANAGEMENT_API_KEY=change-me-management-key
# Separate read-only auditor key. If unset it falls back to the management key
# (dev convenience only — always set a distinct value in production).
CONSENTVAULT_AUDITOR_API_KEY=change-me-auditor-key
# Set to "prod" to disable demo bootstrap keys.
CONSENTVAULT_ENVIRONMENT=dev
